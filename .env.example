# Runtime
T360_ENV=development
T360_LOG_LEVEL=INFO
T360_TRADING_MODE=backtest

# Broker selection: upstox | fyers | zerodha
T360_BROKER=upstox

# Broker credentials are supplied through the deployment environment.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_ACCESS_TOKEN=
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Persistence
T360_DATABASE_URL=sqlite:///./t360.db
T360_REDIS_URL=redis://localhost:6379/0

# AI provider configuration will be added behind an adapter.
T360_AI_PROVIDER=
T360_AI_MODEL=
T360_AI_API_KEY=
